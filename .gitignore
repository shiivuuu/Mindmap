# MindMesh AI .gitignore

# Dependencies
node_modules/
.pnp
.pnp.js

# Testing and coverage
coverage/
.nyc_output
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Production builds
dist/
build/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Editor and OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Database & local storage
*.sqlite
*.db
backend/uploads/*
!backend/uploads/.gitkeep
backend/mindmesh.db
