# MindMesh AI Configuration
APP_NAME=MindMesh AI
APP_ENV=development
SECRET_KEY=mindmesh_development_super_secret_jwt_key_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For PostgreSQL with pgvector:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mindmesh
# For lightweight zero-config SQLite development fallback:
DATABASE_URL=sqlite:///./mindmesh.db

# Storage
FILE_STORAGE_PATH=./uploads
UPLOAD_MAX_MB=25

# CORS and Network
FRONTEND_ORIGIN=http://localhost:5173
HOST=0.0.0.0
PORT=8000

# AI Provider Configuration (Optional - falls back cleanly to local heuristic AI engine if not set)
LLM_PROVIDER=builtin
# Options: builtin, openai, groq, ollama
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
